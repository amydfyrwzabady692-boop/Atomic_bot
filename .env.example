# توکن ربات تلگرام
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# دیتابیس PostgreSQL (همان دیتابیس سایت AccShop)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=accshop
DB_USER=postgres
DB_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD

# زرین‌پال
ZARINPAL_MERCHANT_ID=your-merchant-uuid
ZARINPAL_SANDBOX=0

# دامنه عمومی ربات (DNS باید به IP وی‌پی‌اس اشاره کند)
BOT_DOMAIN=botatomic.atomicshop.ir

# آدرس callback درگاه — از طریق پروکسی Caddy روی همین دامنه
# نباید اسلش انتهایی داشته باشد
PAYMENT_CALLBACK_BASE=https://botatomic.atomicshop.ir
WEB_PORT=8080

# G2Bulk — تحویل خودکار جم
G2BULK_API_KEY=
G2BULK_GAME_CODE=freefire_me
# کلید Fernet اختیاری برای رمزنگاری اطلاعات ورود «جم با اطلاعات».
# اگر خالی باشد، اطلاعات به‌صورت JSON ساده ذخیره می‌شود و بخش کار می‌کند.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNT_CREDENTIALS_KEY=
# نرخ پشتیبان دلار به تومان؛ نرخ اصلی از orderbook عمومی USDTIRT خوانده می‌شود
USD_TOMAN_RATE=
MAX_PAYMENT_AMOUNT=100000000
ORDER_PAYMENT_TTL_MINUTES=15

# کارت‌به‌کارت
CARD_TRANSFER_NUMBER=YOUR_16_DIGIT_CARD_NUMBER
CARD_TRANSFER_HOLDER=YOUR_CARD_HOLDER_NAME
CARD_TRANSFER_BANK=سامان

# آیدی عددی تلگرام ادمین (برای دریافت رسید و دکمه تایید/رد)
ADMIN_CHAT_ID=
